@page "/jobreport/{JobId}"
@using OnlineMongoMigrationProcessor
@using OnlineMongoMigrationProcessor.Models
@inject Service.JobManager JobManager
@inject NavigationManager NavigationManager

<div class="no-print d-flex justify-content-between align-items-center mb-3">
   
    <h3 class="mb-0">
        <button class="btn btn-light me-2" title="Back to Job List" @onclick="GoBack" style="border: none; background: transparent;">
            <i class="bi bi-arrow-left"></i>
        </button>
        @MigrationJob?.Name - Job Report</h3>
    <div class="d-flex align-items-center mb-3">
       
        <button class="btn btn-primary" title="Print" onclick="window.print()">
            <i class="bi bi-printer"></i>
        </button>
    </div>
</div>

@if (MigrationJob is null)
{
    <div class="alert alert-warning">Job not found.</div>
}
else
{
    <style>
        /* Printer friendly styles */
        @@page {
            margin: 8mm;
        }
        @@media print {
            .no-print { display: none !important; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; font-size: 10px; }
            .small-text { font-size: 9px; }
            .table-tight td, .table-tight th { padding: 2px 4px; }
            .group-cell { line-height: 1.2; }
        }
        .kv-table thead th { width: 30%; }
        .kv-table thead th + th { width: 70%; }
        .section-title { font-size: 1.05rem; margin-top: 1rem; }
        .small-text { font-size: .9rem; }
        .nowrap { white-space: nowrap; }
        .wrap { word-break: break-word; }
        .table-tight td, .table-tight th { padding: .135rem .5rem; }
        .report-table { table-layout: fixed; width: 100%; }
        th, td { vertical-align: top; }
        .col-db { width: 18ch; }
        .col-cnt { width: 26ch; }
        .col-cs { width: 28ch; }
        .col-sb { width: 26ch; }        
        .col-cmp { width: 26ch; }
        .group-cell div {}        
        .lbl { color: #555; }
    </style>

    <div>
        
        <table class="table table-borderless table-sm kv-table small-text">
            <thead>
                <tr>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr><td class="nowrap">Job Name</td><td class="wrap">@MigrationJob.Name</td></tr>
                <tr><td class="nowrap">Job Type</td><td>@GetToolName(MigrationJob.JobType)</td></tr>
                <tr><td class="nowrap">Started On (UTC)</td><td>@(MigrationJob.StartedOn?.ToString() ?? "N/A")</td></tr>
                @if (MigrationJob.JobType != JobType.StorageValidation)
                {
                    <tr><td class="nowrap">Is Online</td><td>@(Helper.IsOnline(MigrationJob) ? "Yes" : "No")</td></tr>
                    @if (Helper.IsOnline(MigrationJob))
                    {
                        <tr><td class="nowrap">Change Stream Mode</td><td>@Helper.GetChangeStreamMode(MigrationJob)</td></tr>
                    }
                }
                <tr><td class="nowrap">Is Completed</td><td>@(MigrationJob.IsCompleted ? "Yes" : "No")</td></tr>
                @if (MigrationJob.JobType != JobType.StorageValidation)
                {
                    <tr><td class="nowrap">Sync Back Enabled</td><td>@(MigrationJob.SyncBackEnabled ? "Yes" : "No")</td></tr>
                }
                <tr><td class="nowrap">Source Endpoint</td><td class="wrap">@MigrationJob.SourceEndpoint</td></tr>
                <tr><td class="nowrap">Target Endpoint</td><td class="wrap">@MigrationJob.TargetEndpoint</td></tr>
                <tr><td class="nowrap">Collection Count</td><td>@(@JobManager.GetMigrationUnits(MigrationJob)?.Count ?? 0)</td></tr>
            </tbody>
        </table>
    </div>

    @if (MigrationJob.JobType == JobType.StorageValidation)
    {
        <div class="section-title">Storage Validation</div>

        @foreach (var skipped in GetStorageValidationUnits().Where(mu => mu.SkippedForStorageValidation))
        {
            <div class="alert alert-secondary py-1 mb-1">
                @skipped.DatabaseName.@skipped.CollectionName: Skipped (not selected for drop)
            </div>
        }

        <table class="table table-bordered table-striped table-tight small-text">
            <thead>
                <tr>
                    <th>Namespace</th>
                    <th>Source Docs</th>
                    <th>Source Data</th>
                    <th>Source Indexes</th>
                    <th>Source Total</th>
                    <th>Target Sample Docs</th>
                    <th>Target Sample Data</th>
                    <th>Target Sample Indexes</th>
                    <th>Target Sample Total</th>
                    <th>Target Data / Doc</th>
                    <th>Target Index / Doc</th>
                    <th>Target Total / Doc</th>
                    <th>Projected Target Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mu in GetStorageValidationUnits().Where(mu => mu.StorageValidationResult != null))
                {
                    var result = mu.StorageValidationResult!;
                    <tr>
                        <td>@mu.DatabaseName.@mu.CollectionName</td>
                        <td>@FormatLong(result.EstimatedSourceDocumentCount)</td>
                        <td>@FormatBytes(result.SourceDataBytes)</td>
                        <td>@FormatBytes(result.SourceIndexBytes)</td>
                        <td>@FormatBytes(result.SourceUsedBytes)</td>
                        <td>@FormatLong(result.SampledDocumentCount)</td>
                        <td>@FormatBytes(result.DataBytes)</td>
                        <td>@FormatBytes(result.IndexBytes)</td>
                        <td>@FormatBytes(result.UsedBytes)</td>
                        <td>@FormatBytes(result.DataBytesPerDocument)</td>
                        <td>@FormatBytes(result.IndexBytesPerDocument)</td>
                        <td>@FormatBytes(result.BytesPerDocument)</td>
                        <td>@FormatBytes(result.EstimatedFullCollectionBytes)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="section-title">Source to Projected Target Growth</div>
        <table class="table table-bordered table-striped table-tight small-text">
            <thead>
                <tr>
                    <th>Namespace</th>
                    <th>Storage Type</th>
                    <th>Source Actual</th>
                    <th>Projected Target</th>
                    <th>Growth</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mu in GetStorageValidationUnits().Where(mu => mu.StorageValidationResult != null))
                {
                    var result = mu.StorageValidationResult!;
                    <tr>
                        <td rowspan="3">@mu.DatabaseName.@mu.CollectionName</td>
                        <td>Data</td>
                        <td>@FormatBytes(result.SourceDataBytes)</td>
                        <td>@FormatBytes(result.EstimatedFullCollectionDataBytes)</td>
                        <td>@FormatGrowth(result.DataGrowthPercent, result.SampledDocumentCount)</td>
                    </tr>
                    <tr>
                        <td>Indexes</td>
                        <td>@FormatBytes(result.SourceIndexBytes)</td>
                        <td>@FormatBytes(result.EstimatedFullCollectionIndexBytes)</td>
                        <td>@FormatGrowth(result.IndexGrowthPercent, result.SampledDocumentCount)</td>
                    </tr>
                    <tr>
                        <td>Total</td>
                        <td>@FormatBytes(result.SourceUsedBytes)</td>
                        <td>@FormatBytes(result.EstimatedFullCollectionBytes)</td>
                        <td>@FormatGrowth(result.TotalGrowthPercent, result.SampledDocumentCount)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="section-title">Source Storage by Shard</div>
        @foreach (var shardGroup in GetSourceStorageShardRows().GroupBy(row => row.ShardName).OrderBy(group => group.Key))
        {
            <h5 class="mt-3">Source Shard: @shardGroup.Key</h5>
            <table class="table table-bordered table-striped table-tight small-text">
                <thead>
                    <tr>
                        <th>Namespace</th>
                        <th>Documents</th>
                        <th>Data Storage</th>
                        <th>Index Storage</th>
                        <th>Total Storage</th>
                        <th>Data / Doc</th>
                        <th>Index / Doc</th>
                        <th>Total / Doc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in shardGroup.OrderBy(row => row.Namespace))
                    {
                        <tr>
                            <td>@row.Namespace</td>
                            <td>@FormatLong(row.Result.SampledDocumentCount)</td>
                            <td>@FormatBytes(row.Result.DataBytes)</td>
                            <td>@FormatBytes(row.Result.IndexBytes)</td>
                            <td>@FormatBytes(row.Result.UsedBytes)</td>
                            <td>@FormatBytes(row.Result.DataBytesPerDocument)</td>
                            <td>@FormatBytes(row.Result.IndexBytesPerDocument)</td>
                            <td>@FormatBytes(row.Result.BytesPerDocument)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="section-title">Projected Target Storage by Shard</div>
        @foreach (var shardGroup in GetStorageValidationShardRows().GroupBy(row => row.ShardName).OrderBy(group => group.Key))
        {
            <h5 class="mt-3">Target Shard: @shardGroup.Key</h5>
            <table class="table table-bordered table-striped table-tight small-text">
                <thead>
                    <tr>
                        <th>Namespace</th>
                        <th>Sampled Docs</th>
                        <th>Estimated Docs</th>
                        <th>Data Used</th>
                        <th>Indexes Used</th>
                        <th>Total Used</th>
                        <th>Data / Doc</th>
                        <th>Index / Doc</th>
                        <th>Total / Doc</th>
                        <th>Estimated Full Size</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in shardGroup.OrderBy(row => row.Namespace))
                    {
                        <tr>
                            <td>@row.Namespace</td>
                            <td>@FormatLong(row.Result.SampledDocumentCount)</td>
                            <td>@FormatLong(row.Result.EstimatedSourceDocumentCount)</td>
                            <td>@FormatBytes(row.Result.DataBytes)</td>
                            <td>@FormatBytes(row.Result.IndexBytes)</td>
                            <td>@FormatBytes(row.Result.UsedBytes)</td>
                            <td>@FormatBytes(row.Result.DataBytesPerDocument)</td>
                            <td>@FormatBytes(row.Result.IndexBytesPerDocument)</td>
                            <td>@FormatBytes(row.Result.BytesPerDocument)</td>
                            <td>@FormatBytes(row.Result.EstimatedFullCollectionBytes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (MigrationJob.JobType != JobType.StorageValidation)
    {
        <div class="section-title">Collections</div>
        <table class="table table-bordered table-striped table-tight small-text report-table">
        <thead>
            <tr>
                <th class="col-db">Namespace</th>
                <th class="col-cnt">Offline Copy</th>
                <th class="col-cs">Change Stream</th>
                <th class="col-sb">Sync Back</th>               
                <th class="col-cmp">Comparison</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var mu in (@JobManager.GetMigrationUnits(MigrationJob) ?? new List<MigrationUnit>()))
        {
            var duration = GetDuration(mu.BulkCopyStartedOn, mu.BulkCopyEndedOn);
            <tr>
                 <td class="group-cell">
                    <div><span class="lbl">Database:</span> @mu.DatabaseName</div>
                    <div><span class="lbl">Collection:</span> @mu.CollectionName</div>
                    @if (HasTargetNamespaceMapping(mu))
                    {
                        <div><span class="lbl">Target Namespace:</span> @GetTargetNamespace(mu)</div>
                    }
                    <div><span class="lbl">Overwrite:</span> @FormatOverwrite(mu.Overwrite)</div>
                    <div><span class="lbl">Indexing:</span> @FormatIndexing(mu.IndexingStrategy)</div>
                    <div><span class="lbl">Sharding:</span> @FormatSharding(mu.ShardingStrategy)</div>
                    @if (mu.ShardingStrategy == ShardingStrategy.DontShard && !string.IsNullOrWhiteSpace(mu.MoveToShard))
                    {
                        <div>
                            <span class="lbl">Move To Shard:</span> @mu.MoveToShard
                            @if (mu.BulkCopyStartedOn.HasValue && !mu.MoveStatus)
                            {
                                <span class="text-danger">(failed)</span>
                            }
                        </div>
                    }
                </td>
                <td class="group-cell">
                    <div><span class="lbl">Source Status:</span> @mu.SourceStatus</div>
                    <div><span class="lbl">Started On (UTC):</span> @(mu.BulkCopyStartedOn?.ToString() ?? "N/A")</div>
                    <div><span class="lbl">Ended On (UTC):</span> @(mu.BulkCopyEndedOn?.ToString() ?? "N/A")</div>
                    <div><span class="lbl">Duration:</span> @duration</div>
                    <div><span class="lbl">Non-Unique Indexes Migrated:</span> @(mu.IndexesExpected > 0 ? $"{mu.IndexesMigrated} of {mu.IndexesExpected}{(mu.IndexesFailed > 0 ? $" ({mu.IndexesFailed} failed)" : string.Empty)}" : mu.IndexesMigrated.ToString())</div>
                    <div><span class="lbl">Index Build Progress:</span> @(mu.IndexBuildCompleteExplicit && mu.IndexesFailed == 0 ? "Complete" : mu.IndexBuildCompleteExplicit ? $"Complete ({mu.IndexesFailed} failed)" : mu.IndexPercent >= 100 ? "Verification pending" : $"{mu.IndexPercent:F1}%")</div>
                    <div><span class="lbl">Estimated Count:</span> @FormatLong(mu.EstimatedDocCount)</div>
                    <div><span class="lbl">Actual Count:</span> @FormatLong(mu.ActualDocCount)</div>
                    <div><span class="lbl">Count While Copying:</span> @FormatLong(mu.SourceCountDuringCopy)</div>
                    @{
                        var totals = Helper.GetProcessedTotals(mu);
                    }
                    <div><span class="lbl">Processed Total:</span> @FormatLong(totals.Total)</div>
                    <div><span class="lbl">Insert:</span> @FormatLong(totals.Inserted)</div>
                    <div><span class="lbl">Duplicates (skipped):</span> @FormatLong(totals.Skipped)</div>
                    <div><span class="lbl">Failed:</span> @FormatLong(totals.Failed)</div>
                </td>
                <td class="group-cell">
                    <div><span class="lbl">Mode:</span> @Helper.GetChangeStreamMode(MigrationJob)</div>
                    <div><span class="lbl">Started On (UTC):</span> @GetChangeStreamStartedOnForDisplay(mu, MigrationJob)</div>
                    <div><span class="lbl">Start Resume Token:</span> @(mu.GetOriginalResumeToken(false) ?? "N/A")</div>
                    <div><span class="lbl">Current Timestamp:</span> @(MigrationJob?.JobType == JobType.RUOptimizedCopy ? "N/A" : mu.GetCursorUtcTimestamp(false).ToString())</div>
                    <div><span class="lbl">Current Resume Token:</span> @(mu.GetResumeToken(false) ?? "N/A")</div>
                    <div><span class="lbl">First Change Replayed:</span> @(string.IsNullOrEmpty(mu.GetResumeDocumentKeyForDirection(false)) ? "N/A" : mu.GetInitialDocumenReplayed(false).ToString())</div>
                    <div><span class="lbl">First Change Document:</span> @(mu.GetResumeDocumentKeyForDirection(false)?.ToString() ?? "N/A")</div>
                    <div><span class="lbl">First Change Operation:</span> @(string.IsNullOrEmpty(mu.GetResumeDocumentKeyForDirection(false)) ? "N/A" : mu.GetResumeTokenOperationForDirection(false).ToString())</div>
                    <div><span class="lbl">Last Event Age:</span> @Helper.GetTimestampDiff(mu, false)</div>
                    <div><span class="lbl">Last Batch Count:</span> @FormatLong(mu.CSUpdatesInLastBatch)</div>
                    <div><span class="lbl">Inserted:</span> @FormatLong(mu.CSDocsInserted) (from @FormatLong(mu.CSDInsertEvents) events)</div>
                    <div><span class="lbl">Deleted:</span> @FormatLong(mu.CSDocsDeleted) (from @FormatLong(mu.CSDeleteEvents) events)</div>
                    <div><span class="lbl">Updated:</span> @FormatLong(mu.CSDocsUpdated) (from @FormatLong(mu.CSUpdateEvents) events)</div>
                    <div><span class="lbl">Duplicate Processed:</span> @FormatLong(mu.CSDuplicateDocsSkipped) skipped</div>
                    <div><span class="lbl">Failed (with retries):</span> @FormatLong(mu.CSErrors)</div>
                    <div><span class="lbl">Avg Read Latency (ms):</span> @mu.CSAvgReadLatencyInMS.ToString("F2")</div>
                    <div><span class="lbl">Avg Write Latency (ms):</span> @mu.CSAvgWriteLatencyInMS.ToString("F2")</div>
                    <div><span class="lbl">Last Change UTC Time:</span> @(MigrationJob?.JobType == JobType.RUOptimizedCopy ? "N/A" : (mu.GetCSLastChangeUTCTime(false)?.ToString("yyyy-MM-dd HH:mm:ss") ?? "N/A"))</div>
                    <div><span class="lbl">Last Resume Token With Change:</span> @(mu.GetCSLastResumeTokenWithChange(false) ?? "N/A")</div>
                    @if (Helper.GetChangeStreamMode(MigrationJob) == "Aggressive" && mu.AggressiveCacheDeleted)
                    {
                        <div><span class="lbl">Aggressive:</span> Completed on @(mu.AggressiveCacheDeletedOn?.ToString("yyyy-MM-dd HH:mm:ss") ?? "N/A") UTC</div>
                    }
                </td>
                <td class="group-cell">
                    <div><span class="lbl">Started On (UTC):</span> @(mu.GetChangeStreamStartedOn(true)?.ToString() ?? "N/A")</div>
                    <div><span class="lbl">Start Resume Token:</span> @(mu.GetOriginalResumeToken(true) ?? "N/A")</div>
                    <div><span class="lbl">Current Timestamp:</span> @(MigrationJob?.JobType == JobType.RUOptimizedCopy ? "N/A" : mu.GetCursorUtcTimestamp(true).ToString())</div>
                    <div><span class="lbl">Current Resume Token:</span> @(mu.GetResumeToken(true) ?? "N/A")</div>
                    <div><span class="lbl">First Change Replayed:</span> @(string.IsNullOrEmpty(mu.GetResumeDocumentKeyForDirection(true)) ? "N/A" : mu.GetInitialDocumenReplayed(true).ToString())</div>
                    <div><span class="lbl">First Change Document:</span> @(mu.GetResumeDocumentKeyForDirection(true)?.ToString() ?? "N/A")</div>
                    <div><span class="lbl">First Change Operation:</span> @(string.IsNullOrEmpty(mu.GetResumeDocumentKeyForDirection(true)) ? "N/A" : mu.GetResumeTokenOperationForDirection(true).ToString())</div>
                    <div><span class="lbl">Last Event Age:</span> @Helper.GetTimestampDiff(mu, true)</div>
                    <div><span class="lbl">Last Batch Count:</span> @FormatLong(mu.SyncBackUpdateEvents)</div>
                    <div><span class="lbl">Inserted:</span> @FormatLong(mu.SyncBackDocsInserted) (from @FormatLong(mu.SyncBackInsertEvents) events)</div>
                    <div><span class="lbl">Deleted:</span> @FormatLong(mu.SyncBackDocsDeleted) (from @FormatLong(mu.SyncBackDeleteEvents) events)</div>
                    <div><span class="lbl">Updated:</span> @FormatLong(mu.SyncBackDocsUpdated) (from @FormatLong(mu.SyncBackUpdateEvents) events)</div>
                    <div><span class="lbl">Duplicate Processed:</span> @FormatLong(mu.SyncBackDuplicateDocsSkipped) skipped</div>
                    <div><span class="lbl">Failed (with retries):</span> @FormatLong(mu.SyncBackErrors)</div>
                    <div><span class="lbl">Last Change UTC Time:</span> @(MigrationJob?.JobType == JobType.RUOptimizedCopy ? "N/A" : (mu.GetCSLastChangeUTCTime(true)?.ToString("yyyy-MM-dd HH:mm:ss") ?? "N/A"))</div>
                    <div><span class="lbl">Last Resume Token With Change:</span> @(mu.GetCSLastResumeTokenWithChange(true) ?? "N/A")</div>
                </td>
               
                <td class="group-cell">
                    <div><span class="lbl">Compared On (UTC):</span> @(mu.ComparedOn?.ToString() ?? "N/A")</div>
                    <div><span class="lbl">Differences:</span> @mu.VarianceCount</div>
                </td>
            </tr>
        }
        </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public string JobId { get; set; } = string.Empty;

    private MigrationJob? MigrationJob { get; set; }

    protected override void OnParametersSet()
    {

        MigrationJob = JobManager.GetMigrationJobById(JobId);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    private string GetToolName(OnlineMongoMigrationProcessor.Models.JobType jobType)
    {
        return jobType switch
        {
            OnlineMongoMigrationProcessor.Models.JobType.RUOptimizedCopy => "MongoDB Driver (Cosmos DB RU read optimized)",
            OnlineMongoMigrationProcessor.Models.JobType.MongoDriver => "MongoDB Driver",
            OnlineMongoMigrationProcessor.Models.JobType.DumpAndRestore => "MongoDump and MongoRestore",
            OnlineMongoMigrationProcessor.Models.JobType.StorageValidation => "Storage Validation",
            _ => "NA"
        };
    }

    private static string GetDuration(DateTime? start, DateTime? end)
    {
        if (!start.HasValue || !end.HasValue || start.Value == DateTime.MinValue || end.Value == DateTime.MinValue)
            return "N/A";
        var d = end.Value - start.Value;
        return $"{(int)d.TotalHours}h {d.Minutes}m {d.Seconds}s";
    }

    private static bool HasTargetNamespaceMapping(MigrationUnit mu)
    {
        return !string.Equals(mu.DatabaseName, mu.GetEffectiveTargetDatabaseName(), StringComparison.OrdinalIgnoreCase)
            || !string.Equals(mu.CollectionName, mu.GetEffectiveTargetCollectionName(), StringComparison.OrdinalIgnoreCase);
    }

    private static string GetTargetNamespace(MigrationUnit mu)
    {
        return $"{mu.GetEffectiveTargetDatabaseName()}.{mu.GetEffectiveTargetCollectionName()}";
    }

   

    private static string FormatLong(long value) => string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N0}", value);

    private static string FormatBytes(double value)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var unitIndex = 0;
        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }
        return $"{value:N2} {units[unitIndex]}";
    }

    private static string FormatGrowth(double? value, long sampledDocumentCount)
    {
        return sampledDocumentCount > 0 && value.HasValue
            ? $"{value.Value:+0.00;-0.00;0.00}%"
            : "N/A";
    }

    private List<MigrationUnit> GetStorageValidationUnits()
    {
        return JobManager.GetMigrationUnits(MigrationJob!) ?? new List<MigrationUnit>();
    }

    private IEnumerable<StorageValidationShardRow> GetStorageValidationShardRows()
    {
        return GetStorageValidationUnits()
            .Where(mu => mu.StorageValidationResult != null)
            .SelectMany(mu => mu.StorageValidationResult!.Shards.Select(shard => new StorageValidationShardRow
            {
                Namespace = $"{mu.DatabaseName}.{mu.CollectionName}",
                ShardName = shard.ShardName,
                Result = shard
            }));
    }

    private IEnumerable<StorageValidationShardRow> GetSourceStorageShardRows()
    {
        return GetStorageValidationUnits()
            .Where(mu => mu.StorageValidationResult != null)
            .SelectMany(mu => mu.StorageValidationResult!.SourceShards.Select(shard => new StorageValidationShardRow
            {
                Namespace = $"{mu.DatabaseName}.{mu.CollectionName}",
                ShardName = shard.ShardName,
                Result = shard
            }));
    }

    private sealed class StorageValidationShardRow
    {
        public string Namespace { get; init; } = string.Empty;
        public string ShardName { get; init; } = string.Empty;
        public StorageValidationShardResult Result { get; init; } = new();
    }

    private static string FormatOverwrite(bool? overwrite) => overwrite switch
    {
        true => "Overwrite (drop target before copy)",
        false => "Append (keep existing target data)",
        _ => "Default"
    };

    private static string FormatIndexing(IndexingStrategy? strategy) => strategy switch
    {
        IndexingStrategy.SameAsSource => "Copy indexes from source (non-blocking)",
        IndexingStrategy.SameAsSourceBlocking => "Copy indexes from source (blocking)",
        IndexingStrategy.DontIndex => "Do not create indexes",
        _ => "Default"
    };

    private static string FormatSharding(ShardingStrategy? strategy) => strategy switch
    {
        ShardingStrategy.SameAsSource => "Copy sharding from source",
        ShardingStrategy.DontShard => "Do not shard target collection",
        _ => "Default"
    };

    private static string GetChangeStreamStartedOnForDisplay(MigrationUnit mu, MigrationJob migrationJob)
    {
        var isServerLevel = migrationJob.ChangeStreamLevel == ChangeStreamLevel.Server;
        var startedOn = isServerLevel ? migrationJob.GetChangeStreamStartedOn(false) : mu.GetChangeStreamStartedOn(false);
        return startedOn?.ToString() ?? "N/A";
    }
}
